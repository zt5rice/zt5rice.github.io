---
import { site } from "../data/site";
import { researchAreas } from "../data/profile";
---

<section id="research" class="research" aria-labelledby="research-title">
  <div class="container research-grid">
    <div class="research-number" aria-hidden="true">6</div>
    <div class="research-copy">
      <p class="label">04 / Research</p>
      <h2 id="research-title">Measurement, reproducibility, and scientific computing.</h2>
      <p>
        My research background spans computational imaging, single-molecule
        tracking, machine learning, and research data infrastructure. The work
        produced 6 peer-reviewed publications, along with conference posters
        and presentations, and taught me to preserve provenance, validate
        methods, and make complex results reproducible.
      </p>
      <ul>
        {researchAreas.map((area) => <li>{area}</li>)}
      </ul>
      <a
        class="research-link"
        href={site.person.scholar}
        target="_blank"
        rel="noreferrer"
      >
        View research record ↗
      </a>
    </div>
  </div>
</section>

<style>
  .research {
    padding-block: 5.5rem;
    border-top: 1px solid var(--border);
    scroll-margin-top: 4rem;
  }

  .research-grid {
    display: grid;
    gap: 2rem;
  }

  .research-number {
    color: var(--accent);
    font-size: clamp(7rem, 28vw, 14rem);
    font-weight: 700;
    letter-spacing: -0.09em;
    line-height: 0.75;
  }

  h2 {
    max-width: 14ch;
    margin: 0.75rem 0 0;
    font-size: clamp(2.4rem, 8vw, 3.7rem);
    font-weight: 500;
    letter-spacing: -0.055em;
    line-height: 1.02;
  }

  .research-copy > p:not(.label) {
    max-width: 43rem;
    margin: 1.5rem 0 0;
    color: var(--text-muted);
    font-size: 1rem;
    line-height: 1.75;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    margin: 1.7rem 0 0;
    padding: 0;
    list-style: none;
  }

  li {
    padding: 0.4rem 0.7rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.58rem;
  }

  .research-link {
    display: inline-block;
    margin-top: 2rem;
    color: var(--text);
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  @media (min-width: 48rem) {
    .research-grid {
      grid-template-columns: minmax(11rem, 0.28fr) minmax(0, 0.72fr);
      gap: 4rem;
      align-items: start;
    }

    .research-number {
      position: sticky;
      top: 8rem;
    }
  }

  @media (min-width: 80rem) {
    .research {
      padding-block: 7rem;
      scroll-margin-top: 5.5rem;
    }
  }
</style>
