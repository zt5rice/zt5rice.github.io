---
import { site } from "../data/site";
import ResponsiveImage from "./ResponsiveImage.astro";
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero-grid container">
    <div class="hero-copy">
      <p class="label hero-eyebrow">San Diego / California</p>
      <h1 id="hero-title">Dr. Zhao Tang</h1>
      <p class="discipline">Software Engineer · Data &amp; AI Systems</p>
      <p class="lede">
        I build reliable data platforms, measurable AI products, and
        production systems that hold up under real load.
      </p>
      <div class="hero-actions">
        <a class="button button-primary" href="#work">Explore selected work</a>
        <a class="button" href={site.resume} download>Download resume</a>
      </div>
      <p class="hero-meta" aria-label="Focus areas">
        Systems <span>/</span> Data <span>/</span> AI
        <span>/</span> Reliability
      </p>
    </div>

    <figure class="portrait-panel">
      <div class="portrait-frame">
        <ResponsiveImage
          src="/assets/portfolio/avatar/zhao-tang-portrait.webp"
          width={400}
          height={500}
          alt="Portrait of Dr. Zhao Tang"
          fetchpriority="high"
          decoding="async"
          className="portrait-image"
          sizes="(min-width: 80rem) 28vw, (min-width: 48rem) 34vw, calc(100vw - 3rem)"
        />
        <figcaption class="portrait-caption">
          <span>Dr. Zhao Tang / San Diego</span>
          <span>Portrait 01</span>
        </figcaption>
      </div>
      <div class="portrait-rule" aria-hidden="true"></div>
      <p>Build / Measure / Operate</p>
    </figure>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: 3.5rem 4.5rem;
  }

  .hero::before {
    position: absolute;
    top: 2rem;
    right: -6rem;
    width: 27rem;
    height: 27rem;
    border-radius: 50%;
    background: rgba(255, 106, 61, 0.08);
    content: "";
    filter: blur(8rem);
    pointer-events: none;
  }

  .hero-grid {
    position: relative;
    display: grid;
    gap: 3.5rem;
  }

  .hero-copy > * {
    animation: hero-rise 600ms var(--ease-out) both;
  }

  .hero-copy > :nth-child(2) {
    animation-delay: 60ms;
  }

  .hero-copy > :nth-child(3) {
    animation-delay: 110ms;
  }

  .hero-copy > :nth-child(4) {
    animation-delay: 160ms;
  }

  .hero-copy > :nth-child(5) {
    animation-delay: 210ms;
  }

  .hero-eyebrow::before {
    display: inline-block;
    width: 2rem;
    height: 1px;
    margin-right: 0.65rem;
    background: var(--accent);
    content: "";
    vertical-align: middle;
  }

  h1 {
    margin: 1.25rem 0 0;
    font-size: clamp(3.25rem, 15vw, 5rem);
    font-weight: 700;
    letter-spacing: -0.07em;
    line-height: 0.9;
    text-wrap: balance;
  }

  h1::after {
    display: block;
    width: 4.25rem;
    height: 0.4rem;
    margin-top: 1.15rem;
    border-radius: 999px;
    background: var(--accent);
    content: "";
  }

  .discipline {
    max-width: none;
    margin: 1.55rem 0 0;
    font-size: clamp(1rem, 2.4vw, 1.75rem);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1.15;
    white-space: nowrap;
  }

  .lede {
    max-width: 40rem;
    margin: 1.4rem 0 0;
    color: var(--text-muted);
    font-size: 1rem;
    line-height: 1.65;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .button {
    display: inline-flex;
    min-height: 2.875rem;
    align-items: center;
    justify-content: center;
    padding-inline: 1.2rem;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .button-primary {
    border-color: var(--accent);
    background: var(--accent);
    color: var(--bg);
  }

  .button-primary:hover {
    background: #ff815c;
  }

  .button:not(.button-primary):hover {
    border-color: var(--accent);
  }

  .hero-meta {
    margin: 1.35rem 0 0;
    color: var(--text-dim);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .hero-meta span {
    padding-inline: 0.3rem;
    color: var(--accent);
  }

  .portrait-panel {
    position: relative;
    align-self: start;
    margin: 0;
    animation: hero-rise 700ms 140ms var(--ease-out) both;
  }

  .portrait-frame {
    position: relative;
    padding: 0.75rem;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-lg);
    background:
      linear-gradient(rgba(98, 108, 112, 0.08) 1px, transparent 1px),
      linear-gradient(90deg, rgba(98, 108, 112, 0.08) 1px, transparent 1px),
      var(--surface);
    background-size: 2.75rem 2.75rem;
  }

  :global(.portrait-image) {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    border-radius: var(--radius-md);
    object-fit: cover;
  }

  .portrait-caption {
    position: absolute;
    right: 0.75rem;
    bottom: 0.75rem;
    left: 0.75rem;
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.8rem 0.9rem;
    border-radius: 0 0 var(--radius-md) var(--radius-md);
    background: rgba(9, 11, 13, 0.86);
    color: var(--text);
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.04em;
  }

  .portrait-caption span:last-child {
    color: var(--accent);
    text-transform: uppercase;
  }

  .portrait-rule {
    width: 100%;
    height: 2px;
    margin-top: 0.55rem;
    background: linear-gradient(90deg, var(--accent) 64%, var(--border) 64%);
  }

  .portrait-panel > p {
    margin: 0.7rem 0 0;
    color: var(--text-dim);
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.08em;
    text-align: right;
    text-transform: uppercase;
  }

  @keyframes hero-rise {
    from {
      opacity: 0;
      transform: translateY(1rem);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (min-width: 48rem) {
    .hero {
      padding-block: 5rem 6rem;
    }

    .hero-grid {
      grid-template-columns: minmax(0, 1.15fr) minmax(19rem, 0.85fr);
      align-items: center;
      gap: 3rem;
    }

    h1 {
      font-size: clamp(3.5rem, 7vw, 5rem);
      white-space: nowrap;
    }

    .portrait-panel {
      align-self: center;
    }
  }

  @media (min-width: 80rem) {
    .hero-grid {
      grid-template-columns: minmax(0, 1.25fr) minmax(24rem, 0.75fr);
      gap: 4rem;
    }

    .portrait-frame {
      padding: 1rem;
    }

    .portrait-caption {
      right: 1rem;
      bottom: 1rem;
      left: 1rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-copy > *,
    .portrait-panel {
      animation: none;
    }
  }
</style>
