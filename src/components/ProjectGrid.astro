---
import { getCollection } from "astro:content";
import ResponsiveImage from "./ResponsiveImage.astro";

const projects = (await getCollection("work")).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<section id="work" class="work" aria-labelledby="work-title">
  <div class="container">
    <div class="section-heading">
      <div>
        <p class="label">01 / Selected work</p>
        <h2 id="work-title">Systems built for evidence, not just demos.</h2>
      </div>
      <p class="intro">
        Streaming infrastructure, retrieval engineering, governed analytics, and
        scientific computing—with measured outcomes and explicit boundaries.
      </p>
    </div>

    <div class="project-grid">
      {
        projects.map((project, index) => (
          <a
            class="project-card"
            href={`/work/${project.id}/`}
            aria-label={`Read the ${project.data.title} case study`}
            data-reveal
            style={`--reveal-delay: ${index * 55}ms`}
          >
            <div class="project-media">
              <ResponsiveImage
                src={project.data.poster}
                width={project.data.posterWidth}
                height={project.data.posterHeight}
                alt=""
                loading="lazy"
                decoding="async"
                className="project-image"
                sizes="(min-width: 48rem) 44vw, calc(100vw - 3rem)"
              />
              <span class="project-index">
                {String(index + 1).padStart(2, "0")}
              </span>
            </div>
            <div class="project-content">
              <p class="project-category">{project.data.category}</p>
              <h3>{project.data.title}</h3>
              <p class="project-summary">{project.data.summary}</p>
              <ul class="project-metrics" aria-label="Selected results">
                {project.data.metrics.map((metric) => (
                  <li>{metric.value}</li>
                ))}
              </ul>
              <div class="project-footer">
                <span>{project.data.stack.slice(0, 4).join(" · ")}</span>
                <span>Read case study →</span>
              </div>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .work {
    padding-block: 5.5rem;
  }

  .section-heading {
    display: grid;
    gap: 1.5rem;
    align-items: end;
    margin-bottom: 2.5rem;
  }

  h2 {
    max-width: 13ch;
    margin: 0.9rem 0 0;
    font-size: clamp(2.6rem, 9vw, 3.8rem);
    font-weight: 500;
    letter-spacing: -0.055em;
    line-height: 0.98;
  }

  .intro {
    max-width: 35rem;
    margin: 0;
    color: var(--text-muted);
    font-size: 0.95rem;
    line-height: 1.65;
  }

  .project-grid {
    display: grid;
    gap: 1.5rem;
  }

  .project-card {
    display: grid;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--surface);
    color: var(--text);
    text-decoration: none;
    transition:
      border-color var(--duration-fast) ease,
      background-color var(--duration-fast) ease;
  }

  .project-card:hover {
    border-color: var(--border-strong);
    background: var(--surface-raised);
  }

  .project-media {
    position: relative;
    overflow: hidden;
    aspect-ratio: 16 / 9;
    background: #101315;
  }

  .project-media :global(picture) {
    width: 100%;
    height: 100%;
  }

  :global(.project-image) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 500ms var(--ease-out);
  }

  .project-card:hover :global(.project-image) {
    transform: scale(1.015);
  }

  .project-index {
    position: absolute;
    top: 0.8rem;
    right: 0.8rem;
    padding: 0.25rem 0.45rem;
    border: 1px solid rgba(255, 255, 255, 0.16);
    background: rgba(9, 11, 13, 0.8);
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.58rem;
  }

  .project-content {
    padding: 1.35rem;
  }

  .project-category {
    margin: 0;
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  h3 {
    margin: 0.5rem 0 0;
    font-size: 1.55rem;
    font-weight: 600;
    letter-spacing: -0.04em;
  }

  .project-summary {
    max-width: 38rem;
    margin: 0.75rem 0 0;
    color: var(--text-muted);
    font-size: 0.9rem;
    line-height: 1.6;
  }

  .project-metrics {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin: 1.25rem 0 0;
    padding: 0;
    list-style: none;
  }

  .project-metrics li {
    padding: 0.35rem 0.6rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
    background: var(--surface-raised);
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.58rem;
  }

  .project-footer {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 1.20rem;
    padding-top: 0.95rem;
    border-top: 1px solid var(--border);
    color: var(--text-dim);
    font-family: var(--font-mono);
    font-size: 0.56rem;
  }

  .project-footer span:last-child {
    color: var(--text);
    text-align: right;
    text-transform: uppercase;
  }

  @media (min-width: 48rem) {
    .section-heading {
      grid-template-columns: minmax(0, 1.4fr) minmax(16rem, 0.6fr);
      gap: 3rem;
    }

    .project-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 80rem) {
    .work {
      padding-block: 7rem;
    }

    .project-content {
      padding: 1.6rem;
    }
  }
</style>
