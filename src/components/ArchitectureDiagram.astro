---
interface Node {
  label: string;
  detail: string;
}

interface Props {
  primary: Node[];
  supporting?: Node[];
  caption: string;
  label: string;
}

const { primary, supporting = [], caption, label } = Astro.props;
---

<figure class="architecture" aria-label={label}>
  <ol class="primary-flow">
    {
      primary.map((node, index) => (
        <li>
          <span class="node-index">{String(index + 1).padStart(2, "0")}</span>
          <strong>{node.label}</strong>
          <span>{node.detail}</span>
        </li>
      ))
    }
  </ol>

  {
    supporting.length > 0 && (
      <div class="supporting">
        <p class="label">Supporting systems</p>
        <ul>
          {supporting.map((node) => (
            <li>
              <strong>{node.label}</strong>
              <span>{node.detail}</span>
            </li>
          ))}
        </ul>
      </div>
    )
  }

  <figcaption>{caption}</figcaption>
</figure>

<style>
  .architecture {
    margin: 0;
    padding: 1rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background:
      linear-gradient(rgba(98, 108, 112, 0.06) 1px, transparent 1px),
      linear-gradient(90deg, rgba(98, 108, 112, 0.06) 1px, transparent 1px),
      rgba(15, 18, 21, 0.86);
    background-size: 3rem 3rem;
  }

  .primary-flow {
    display: grid;
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .primary-flow li {
    position: relative;
    display: grid;
    gap: 0.32rem;
    min-height: 5.4rem;
    align-content: center;
    padding: 1rem;
    border: 1px solid var(--border);
    border-left: 3px solid var(--accent);
    background: rgba(18, 21, 24, 0.92);
  }

  .primary-flow li:not(:last-child)::after {
    position: absolute;
    bottom: -1rem;
    left: 50%;
    color: var(--accent);
    content: "↓";
    font-family: var(--font-mono);
    font-size: 0.75rem;
    transform: translateX(-50%);
  }

  .node-index {
    color: var(--text-dim);
    font-family: var(--font-mono);
    font-size: 0.52rem;
  }

  strong {
    color: var(--text);
    font-size: 0.88rem;
    font-weight: 500;
  }

  .primary-flow li > span:last-child,
  .supporting li span {
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.56rem;
    line-height: 1.5;
  }

  .supporting {
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }

  .supporting > .label {
    margin: 0 0 0.8rem;
  }

  .supporting ul {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.65rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .supporting li {
    display: grid;
    gap: 0.22rem;
    padding: 0.8rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: rgba(18, 21, 24, 0.74);
  }

  figcaption {
    margin-top: 1.5rem;
    color: var(--text-dim);
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.04em;
    text-align: right;
    text-transform: uppercase;
  }

  @media (min-width: 64rem) {
    .architecture {
      padding: 2rem;
    }

    .primary-flow {
      grid-template-columns: repeat(auto-fit, minmax(7.2rem, 1fr));
      gap: 1.4rem;
    }

    .primary-flow li {
      min-height: 7.5rem;
    }

    .primary-flow li:not(:last-child)::after {
      top: 50%;
      right: -1.18rem;
      bottom: auto;
      left: auto;
      content: "→";
      transform: translateY(-50%);
    }

    .supporting ul {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>
