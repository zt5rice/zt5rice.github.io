---
const metrics = [
  {
    value: "100M+",
    label: "TurboTax and QuickBooks users supported by Intuit data products",
  },
  {
    value: "40%",
    label: "Lower MTTR through distributed tracing and root-cause analysis",
  },
  {
    value: "0.840",
    label: "Hybrid Hit@5 on GraphAtlas's 50-question benchmark",
  },
  {
    value: "6",
    label:
      "Peer-reviewed publications, plus conference posters and presentations",
  },
];
---

<section class="proof" aria-label="Selected outcomes">
  <div class="container">
    <ul>
      {
        metrics.map((metric) => (
          <li>
            <strong>{metric.value}</strong>
            <span>{metric.label}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .proof {
    border-block: 1px solid var(--border);
    background: rgba(10, 13, 15, 0.72);
  }

  ul {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    display: grid;
    align-content: start;
    gap: 0.55rem;
    padding: 1.4rem 1rem 1.45rem 0;
  }

  li:nth-child(even) {
    padding-right: 0;
    padding-left: 1rem;
    border-left: 1px solid var(--border);
  }

  li:nth-child(n + 3) {
    border-top: 1px solid var(--border);
  }

  strong {
    font-size: clamp(1.65rem, 7vw, 2.2rem);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 1;
  }

  span {
    max-width: 16rem;
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    line-height: 1.5;
  }

  @media (min-width: 48rem) {
    ul {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    li {
      min-height: 8.4rem;
      padding: 1.8rem 1.4rem 1.75rem;
    }

    li:first-child {
      padding-left: 0;
    }

    li:nth-child(even) {
      padding-left: 1.4rem;
    }

    li:nth-child(n + 2) {
      border-top: 0;
      border-left: 1px solid var(--border);
    }
  }
</style>
