---
import { site } from "../data/site";
---

<section id="contact" class="contact" aria-labelledby="contact-title">
  <div class="container">
    <p class="label">05 / Contact</p>
    <h2 id="contact-title">Let’s build systems that can be trusted after launch.</h2>
    <p class="contact-copy">
      For roles, collaborations, or technical conversations about data
      platforms, production AI, and reliability, reach me at the links below.
    </p>
    <div class="contact-actions">
      <a class="button primary" href={`mailto:${site.person.email}`}>Email me</a>
      <a href={site.person.linkedin} target="_blank" rel="noreferrer">LinkedIn ↗</a>
      <a href={site.person.github} target="_blank" rel="noreferrer">GitHub ↗</a>
      <a href={site.resume} download>Download resume ↗</a>
    </div>
    <p class="contact-email">{site.person.email}</p>
  </div>
</section>

<style>
  .contact {
    padding-block: 5.5rem;
    border-top: 1px solid var(--border);
    scroll-margin-top: 4rem;
  }

  h2 {
    max-width: 15ch;
    margin: 0.8rem 0 0;
    font-size: clamp(2.7rem, 9vw, 4.7rem);
    font-weight: 500;
    letter-spacing: -0.06em;
    line-height: 1;
  }

  .contact-copy {
    max-width: 40rem;
    margin: 1.5rem 0 0;
    color: var(--text-muted);
    font-size: 1rem;
    line-height: 1.7;
  }

  .contact-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem 1.2rem;
    align-items: center;
    margin-top: 2rem;
  }

  .contact-actions a:not(.button) {
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.65rem;
    text-transform: uppercase;
  }

  .button {
    display: inline-flex;
    min-height: 2.875rem;
    align-items: center;
    padding-inline: 1.4rem;
    border: 1px solid var(--accent);
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .primary {
    background: var(--accent);
    color: var(--bg);
  }

  .contact-email {
    margin: 2.5rem 0 0;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
    color: var(--text-dim);
    font-family: var(--font-mono);
    font-size: 0.65rem;
  }

  @media (min-width: 80rem) {
    .contact {
      padding-block: 7rem;
      scroll-margin-top: 5.5rem;
    }
  }
</style>
