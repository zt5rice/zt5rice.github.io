---
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { site } from "../data/site";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Page not found — Dr. Zhao Tang" noindex>
  <SiteHeader />
  <main id="main" class="not-found">
    <div class="container">
      <p class="label">404 / Route not found</p>
      <h1>This page is not part of the system.</h1>
      <p class="copy">
        The address may have moved, or the link may be incomplete. Return home
        to explore the selected work.
      </p>
      <div class="actions">
        <a class="button" href="/">Return home</a>
        <a href={site.person.github}>GitHub ↗</a>
        <a href={site.resume} download>Resume ↗</a>
      </div>
      <p class="code">ERROR / 404 · PATH_NOT_FOUND</p>
    </div>
  </main>
  <SiteFooter />
</BaseLayout>

<style>
  .not-found {
    display: grid;
    min-height: 68vh;
    align-items: center;
    padding-block: 5rem;
    border-bottom: 1px solid var(--border);
  }

  h1 {
    max-width: 11ch;
    margin: 0.9rem 0 0;
    font-size: clamp(3.2rem, 12vw, 6.4rem);
    font-weight: 600;
    letter-spacing: -0.065em;
    line-height: 0.95;
  }

  .copy {
    max-width: 38rem;
    margin: 1.5rem 0 0;
    color: var(--text-muted);
    font-size: 1rem;
    line-height: 1.7;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem 1.2rem;
    align-items: center;
    margin-top: 2rem;
  }

  .actions a:not(.button) {
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    text-transform: uppercase;
  }

  .button {
    display: inline-flex;
    min-height: 2.875rem;
    align-items: center;
    padding-inline: 1.2rem;
    border: 1px solid var(--accent);
    border-radius: var(--radius-sm);
    background: var(--accent);
    color: var(--bg);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .code {
    margin: 4rem 0 0;
    color: var(--text-dim);
    font-family: var(--font-mono);
    font-size: 0.56rem;
    letter-spacing: 0.06em;
  }
</style>
